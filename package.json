{
  "name": "careerforge",
  "version": "1.0.0",
  "description": "AI Career & ATS Platform - Analyze, Optimize, Discover, Apply, Track",
  "main": "server/src/server.js",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm run build --workspace=client && npx prisma generate --schema=prisma/schema.prisma",
    "server": "node server/src/server.js",
    "client": "vite client",
    "dev:server": "node --watch server/src/server.js",
    "dev:client": "vite client",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:db-push": "prisma db push --schema=prisma/schema.prisma",
    "test": "node server/tests/runAllTests.js"
  },
  "keywords": [
    "ats",
    "resume-analyzer",
    "groq-ai",
    "job-discovery",
    "career-platform"
  ],
  "author": "Antigravity Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "groq-sdk": "^0.3.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "mammoth": "^1.7.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.10",
    "pdf-parse": "^1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "recharts": "^2.12.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "prisma": "^5.10.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
